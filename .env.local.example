# Vercel Postgres connection string(s) - get these from your Vercel project's
# Storage tab after creating a Postgres database. Vercel usually adds these
# automatically when you link the database to your project, both locally
# (via `vercel env pull`) and in production.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Any long random string, used to encrypt the login session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
